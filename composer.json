{
    "name": "popphp/popphp",
    "description": "Pop PHP Framework, a lightweight, robust PHP framework",
    "keywords": [
        "framework",
        "php framework",
        "pop",
        "pop php"
    ],
    "homepage": "https://github.com/popphp/popphp",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Nick Sagona",
            "email": "dev@noladev.com",
            "homepage": "https://www.popphp.org/"
        }
    ],
    "require": {
        "php": ">=8.4.0",
        "popphp/pop-config" : "^4.0.4",
        "popphp/pop-console" : "^5.0.0-beta.3",
        "popphp/pop-cookie" : "^4.0.4",
        "popphp/pop-db" : "^6.8.14",
        "popphp/pop-http" : "^6.0.0-beta.1",
        "popphp/pop-utils" : "^2.5.0-beta.1",
        "vlucas/phpdotenv": "^5.6.4",
        "psr/container": "^2.0.2",
        "psr/event-dispatcher": "^1.0.0",
        "psr/http-message": "^2.0",
        "psr/http-server-middleware": "^1.0.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5.0"
    },
    "autoload": {
        "psr-4": {
            "Pop\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pop\\Test\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "5.0.x-dev"
        }
    }
}
